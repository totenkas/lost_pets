<h1><%= @pet.name %></h1>

<p>Species: <%= @pet.species %></p>
<p>Address: <%= @pet.address %></p>
<p>Found on: <%= @pet.found_on %></p>
<p>Found <%= @pet.found_days_ago %> days ago</p>

<%= link_to "Delete this pet",
    pet_path(@pet),
    data: { turbo_method: :delete } %>

<%= link_to "Back to all pets", pets_path %>
